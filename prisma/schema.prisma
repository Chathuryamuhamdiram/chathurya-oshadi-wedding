generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String                @id @default(uuid())
  fullName             String
  email                String                @unique
  phone                String?
  passwordHash         String?
  role                 String                @default("VIEWER")
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  fundBalanceSnapshots FundBalanceSnapshot[]
  notifications        Notification[]
  assignedTasks        Task[]                @relation("AssignedTasks")
  createdTasks         Task[]                @relation("CreatedTasks")
  taskComments         TaskComment[]
  userPermissions      UserPermission[]
  preferences          UserPreference?
  assignedTasksMulti   Task[]                @relation("TaskAssignees")
}

model CeremonyEvent {
  id                   String                @id @default(uuid())
  name                 String
  eventType            CeremonyType          @default(WEDDING)
  eventDate            DateTime?
  startTime            String?
  endTime              String?
  venueName            String?
  venueAddress         String?
  description          String?
  status               CeremonyStatus        @default(PLANNING)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  budgetItems          BudgetItem[]
  contributions        Contribution[]
  guestLinks           EventGuest[]
  eventPlanItems       EventPlanItem[]
  foodMenus            FoodMenu[]
  fundBalanceSnapshots FundBalanceSnapshot[]
  tasks                Task[]
  itineraryEvents      WeddingEvent[]
}

model EventGuest {
  id              String        @id @default(uuid())
  guestId         String
  eventId         String
  invitationCount Int?
  rsvpStatus      String?
  confirmedCount  Int?
  liquorCount     Int?
  tableNumber     String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  send            Boolean       @default(false)
  sendAt          DateTime?
  event           CeremonyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest           Guest         @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([guestId, eventId])
  @@index([eventId])
  @@index([guestId])
}

model Guest {
  id                     String          @id @default(uuid())
  invitationCode         String          @unique
  displayName            String
  primaryContactName     String?
  whatsappNumber         String?
  email                  String?
  invitationType         String          @default("INDIVIDUAL")
  allowedGuestCount      Int             @default(1)
  confirmedGuestCount    Int             @default(0)
  liquorCount            Int             @default(0)
  side                   String          @default("BRIDE")
  rsvpStatus             String          @default("PENDING")
  invitationStatus       String          @default("NOT_SENT")
  invitationSentAt       DateTime?
  invitationLastSharedAt DateTime?
  notes                  String?
  tableId                String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  eventGuests            EventGuest[]
  table                  SeatingTable?   @relation(fields: [tableId], references: [id])
  logistics              GuestLogistics?

  @@index([rsvpStatus])
  @@index([side])
  @@index([invitationStatus])
}

model SeatingTable {
  id        String   @id @default(uuid())
  name      String
  capacity  Int      @default(8)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guests    Guest[]
}

model BudgetCategory {
  id          String       @id @default(uuid())
  name        String
  description String?
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  items       BudgetItem[]
}

model Vendor {
  id              String         @id @default(uuid())
  vendorName      String
  contactName     String?
  phone           String?
  whatsappNumber  String?
  email           String?
  serviceCategory String?
  quotationAmount Decimal        @default(0) @db.Decimal(10, 2)
  finalAmount     Decimal        @default(0) @db.Decimal(10, 2)
  advancePaid     Decimal        @default(0) @db.Decimal(10, 2)
  nextPaymentDue  DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  isArchived      Boolean        @default(false)
  status          VendorStatus   @default(POTENTIAL)
  items           BudgetItem[]
  foodMenus       FoodMenu[]
  foodMenuItems   FoodMenuItem[]
}

model BudgetItem {
  id                String         @id @default(uuid())
  categoryId        String
  vendorId          String?
  title             String
  description       String?
  estimatedCost     Decimal        @default(0) @db.Decimal(10, 2)
  actualCost        Decimal        @default(0) @db.Decimal(10, 2)
  paidAmount        Decimal        @default(0) @db.Decimal(10, 2)
  paymentDueDate    DateTime?
  paymentStatus     String         @default("NOT_STARTED")
  responsibleUserId String?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  eventId           String?
  category          BudgetCategory @relation(fields: [categoryId], references: [id])
  event             CeremonyEvent? @relation(fields: [eventId], references: [id])
  vendor            Vendor?        @relation(fields: [vendorId], references: [id])
  expenses          Expense[]

  @@index([eventId])
  @@index([categoryId])
  @@index([vendorId])
  @@index([paymentStatus])
}

model Expense {
  id            String              @id @default(uuid())
  budgetItemId  String
  expenseName   String
  expenseDate   DateTime            @default(now())
  amount        Decimal             @db.Decimal(10, 2)
  paidByUserId  String?
  paymentMethod String?
  notes         String?
  createdAt     DateTime            @default(now())
  expenseType   ExpenseType         @default(OTHER)
  budgetItem    BudgetItem          @relation(fields: [budgetItemId], references: [id])
  attachments   ExpenseAttachment[]

  @@index([budgetItemId])
  @@index([expenseDate])
}

model ExpenseAttachment {
  id               String   @id @default(uuid())
  expenseId        String
  fileName         String
  originalFileName String
  mimeType         String
  fileSize         Int
  storagePath      String
  uploadedBy       String?
  uploadedAt       DateTime @default(now())
  expense          Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

model Contribution {
  id               String         @id @default(uuid())
  contributorName  String
  amount           Decimal        @db.Decimal(10, 2)
  contributionDate DateTime       @default(now())
  paymentMethod    String?
  purpose          String?
  notes            String?
  createdAt        DateTime       @default(now())
  reference        String?
  status           String         @default("RECEIVED")
  updatedAt        DateTime       @updatedAt
  eventId          String?
  event            CeremonyEvent? @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@index([status])
}

model FundBalanceSnapshot {
  id            String         @id @default(uuid())
  eventId       String?
  amount        Decimal        @db.Decimal(10, 2)
  effectiveDate DateTime
  note          String?
  updatedById   String?
  createdAt     DateTime       @default(now())
  event         CeremonyEvent? @relation(fields: [eventId], references: [id])
  updatedBy     User?          @relation(fields: [updatedById], references: [id])

  @@index([eventId])
  @@index([updatedById])
}

model Task {
  id               String           @id @default(uuid())
  title            String
  description      String?
  category         String?
  assignedUserId   String?
  createdById      String?
  startDate        DateTime?
  targetDate       DateTime?        @map("dueDate")
  priority         String           @default("MEDIUM")
  status           String           @default("NOT_STARTED")
  reminderSettings String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  eventId          String?
  assignedUser     User?            @relation("AssignedTasks", fields: [assignedUserId], references: [id])
  createdBy        User?            @relation("CreatedTasks", fields: [createdById], references: [id])
  event            CeremonyEvent?   @relation(fields: [eventId], references: [id])
  attachments      TaskAttachment[]
  comments         TaskComment[]
  blockedBy        TaskDependency[] @relation("BlocksTask")
  blocks           TaskDependency[] @relation("BlockedByTask")
  items            TaskItem[]
  reminders        TaskReminder[]
  assignees        User[]           @relation("TaskAssignees")

  @@index([eventId])
  @@index([status])
  @@index([assignedUserId])
  @@index([targetDate])
}

model TaskItem {
  id        String   @id @default(uuid())
  taskId    String
  name      String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskDependency {
  id             String @id @default(uuid())
  blockingTaskId String
  blockedTaskId  String
  blockedTask    Task   @relation("BlocksTask", fields: [blockedTaskId], references: [id], onDelete: Cascade)
  blockingTask   Task   @relation("BlockedByTask", fields: [blockingTaskId], references: [id], onDelete: Cascade)

  @@unique([blockingTaskId, blockedTaskId])
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaskAttachment {
  id         String   @id @default(uuid())
  taskId     String
  fileName   String
  fileUrl    String
  fileType   String?
  uploadedBy String
  createdAt  DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskReminder {
  id           String    @id @default(uuid())
  taskId       String
  reminderType String
  reminderAt   DateTime
  status       String    @default("PENDING")
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([status, reminderAt])
}

model Venue {
  id            String         @id @default(uuid())
  name          String
  address       String?
  googleMapsUrl String?
  phone         String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  events        WeddingEvent[]
}

model WeddingEvent {
  id          String         @id @default(uuid())
  title       String
  description String?
  eventDate   DateTime?
  startTime   String?
  endTime     String?
  venueId     String?
  visibility  String         @default("PUBLIC")
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  eventId     String?
  items       EventItem[]
  event       CeremonyEvent? @relation(fields: [eventId], references: [id])
  venue       Venue?         @relation(fields: [venueId], references: [id])

  @@index([eventId])
  @@index([eventDate])
}

model EventItem {
  id        String       @id @default(uuid())
  eventId   String
  name      String
  quantity  String       @default("1")
  status    String       @default("PENDING")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  event     WeddingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model GuestLogistics {
  id                String    @id @default(uuid())
  guestId           String    @unique
  arrivalDateTime   DateTime?
  departureDateTime DateTime?
  accommodationName String?
  transportNotes    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  guest             Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model UserPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  emailNotifications Boolean  @default(false)
  inAppNotifications Boolean  @default(true)
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GuestbookEntry {
  id        String   @id @default(uuid())
  name      String
  message   String
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  roles       RolePermission[]
  users       UserPermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  role         String
  permissionId String
  allowed      Boolean    @default(true)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  allowed      Boolean    @default(true)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(uuid())
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteAsset {
  id        String   @id @default(uuid())
  key       String   @unique
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FoodMenu {
  id          String               @id @default(uuid())
  eventId     String?
  title       String
  venue       String?
  vendorId    String?
  status      String               @default("DRAFT")
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  event       CeremonyEvent?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor      Vendor?              @relation(fields: [vendorId], references: [id])
  attachments FoodMenuAttachment[]
  sections    FoodMenuSection[]

  @@index([eventId])
  @@index([vendorId])
}

model FoodMenuSection {
  id        String         @id @default(uuid())
  menuId    String
  title     String
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  items     FoodMenuItem[]
  menu      FoodMenu       @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
}

model FoodMenuItem {
  id           String          @id @default(uuid())
  sectionId    String
  name         String
  description  String?
  cost         Decimal?        @db.Decimal(10, 2)
  costType     String?
  vendorId     String?
  status       String          @default("PLANNED")
  sortOrder    Int             @default(0)
  isVegetarian Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  section      FoodMenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  vendor       Vendor?         @relation(fields: [vendorId], references: [id])

  @@index([sectionId])
  @@index([vendorId])
}

model FoodMenuAttachment {
  id         String   @id @default(uuid())
  menuId     String
  fileName   String
  fileUrl    String
  fileType   String?
  uploadedBy String
  createdAt  DateTime @default(now())
  menu       FoodMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
}

model EventPlanItem {
  id          String        @id @default(uuid())
  eventId     String
  activity    String
  plannedTime String?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  event       CeremonyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

enum CeremonyType {
  WEDDING
  HOMECOMING
  PORUWA
  ENGAGEMENT
  PRE_SHOOT
  AFTER_PARTY
  OTHER
}

enum CeremonyStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum VendorStatus {
  POTENTIAL
  SHORTLISTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ExpenseType {
  ADVANCE
  INSTALLMENT
  FINAL_PAYMENT
  OTHER
}
